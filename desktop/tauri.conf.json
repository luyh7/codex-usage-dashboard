{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Usage Dashboard",
  "version": "1.1.0",
  "identifier": "io.github.luyh7.cousash",
  "build": { "frontendDist": "bootstrap" },
  "app": { "windows": [], "withGlobalTauri": true, "security": { "capabilities": ["bootstrap"], "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" } },
  "plugins": { "updater": { "pubkey": "", "endpoints": [], "requireSignedVersion": true } },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local Codex usage, sessions and cost estimates",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "externalBin": ["binaries/codex-usage-dashboard"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["English", "SimpChinese"], "displayLanguageSelector": true, "installerHooks": "installer-hooks.nsh" }, "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } },
    "macOS": { "minimumSystemVersion": "14.5" },
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"] }, "appimage": { "bundleMediaFramework": false } }
  }
}
